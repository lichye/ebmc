CORE
undriven_mode.sv
--bound 2 --undriven const
^\[main\.same_frame\].*: PROVED.*$
^\[main\.stable_enable\].*: PROVED.*$
^\[main\.stable_gap\].*: PROVED.*$
^\[main\.any_initial\].*: REFUTED$
^\[main\.driven\].*: PROVED.*$
^\[main\.primary_can_change\].*: REFUTED$
^\[main\.literal_can_change\].*: REFUTED$
^\[main\.port_alias\].*: PROVED.*$
^\[main\.port_stable\].*: PROVED.*$
^EXIT=10$
^SIGNAL=0$

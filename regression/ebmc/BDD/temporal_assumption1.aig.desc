temporal_assumption1.sv
--aig --bound 5
^\[main\.assume\.1\] always \(main\.a \|=> main\.b\): ASSUMED$
^\[main\.p0\] always main\.r -> main\.b: PROVED up to bound 5$
^EXIT=0$
^SIGNAL=0$
